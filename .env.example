# WEBSITE project only. Fill these in Vercel Production environment variables.
SITE_URL=https://YOUR-WEBSITE-DOMAIN
DASHBOARD_URL=https://YOUR-DASHBOARD-DOMAIN
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
CUSTOMER_SESSION_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CHATBOT_OTP_SECRET=KEEP_YOUR_EXISTING_OTP_SECRET_OR_GENERATE_A_32_CHARACTER_SECRET
# Must match CRON_SECRET in the dashboard project.
